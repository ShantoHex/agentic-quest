# Proof Quest frontend config. All values are public (no secrets belong here).
# Defaults below target BSC testnet (chain 97). For mainnet set VITE_CHAIN_ID=56,
# the mainnet ProofQuest address, and the official Agent ID registry.

VITE_CHAIN_ID=97
VITE_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
VITE_PROOFQUEST_ADDRESS=0xCE3277D3Cbf7e0785627A63dA7Bb595669322d19
# Testnet MockAgentID. Mainnet official registry: 0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F
VITE_AGENT_ID_REGISTRY=0xD126FBafc7e7a609056e421187A0286FFC27e5c5
# true only on testnet: shows a "mint a test handle" helper for the MockAgentID registry
VITE_MOCK_REGISTRY=true
# Quick-pick ERC-20 prize token. Testnet: MockERC20 "Test USDT" (18 decimals, read on-chain). (mainnet USDT: 0x55d398326f99059fF77548524633006e1a0d54EE)
VITE_USDT_ADDRESS=0x6898e0e131FDB06b9Ae8d4C3f4475438F04c3398
# Block explorer base URL (mainnet: https://bscscan.com)
VITE_EXPLORER_URL=https://testnet.bscscan.com
# Public source repository (shown on the Transparency page)
VITE_SOURCE_REPO_URL=
# Verified source (Sourcify full match on testnet)
VITE_SOURCE_VERIFIED_URL=https://repo.sourcify.dev/97/0xCE3277D3Cbf7e0785627A63dA7Bb595669322d19
# RewardDrop (one random USDT reward per Agent ID)
VITE_REWARD_DROP_ADDRESS=0xeF23c96f73d87c62d16e6672F20B275A30058E2F
VITE_REWARD_DROP_SOURCE_URL=https://repo.sourcify.dev/97/0xeF23c96f73d87c62d16e6672F20B275A30058E2F
# Minimum EIP-1559 priority tip in gwei (RPC rejects < 0.1)
VITE_MIN_PRIORITY_GWEI=0.1
# Social tasks (verification not wired yet)
VITE_X_HANDLE=shantohexnew
VITE_X_POST_URL=
