# Copy to .env (never commit .env). Do not put a real main-wallet key here.
# Use a fresh deployer wallet with only a few dollars of BNB for gas.

PRIVATE_KEY=
OWNER=

# BSC mainnet
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
AGENT_ID_REGISTRY=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F

# BSC testnet (Chapel, chain 97). Leave AGENT_ID_REGISTRY empty to deploy MockAgentID.
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
# AGENT_ID_REGISTRY=
# TEST_PRIZE_TOKEN=

# For `forge verify-contract` / `--verify`
BSCSCAN_API_KEY=
